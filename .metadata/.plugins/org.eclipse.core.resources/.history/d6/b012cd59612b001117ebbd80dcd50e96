package com.multigenesys.AuthService.dto;

public class AuthResponse {
	
    private String message;
    private String status;
    private String token;
   
	public AuthResponse() {
		super();
	}
	
	

	public AuthResponse(String message, String status) {
		super();
		this.message = message;
		this.status = status;
	
	}
	public AuthResponse(String message, String status, String token) {
		super();
		this.message = message;
		this.status = status;
		this.token = token;
	}

	public String getMessage() {
		return message;
	}

	public void setMessage(String message) {
		this.message = message;
	}

	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}

	public String getToken() {
		return token;
	}

	public void setToken(String token) {
		this.token = token;
	}

	@Override
	public String toString() {
		return "AuthResponse [message=" + message + ", status=" + status + ", token=" + token + "]";
	}

	
    
}
